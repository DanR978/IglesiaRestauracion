-- ============================================================================
-- supabase/tests/helpers/fixtures.psql — shared fixtures for the pgTAP suite
-- ============================================================================
-- Synthetic accounts (no real people, no PII) and one or two rows per table,
-- inserted as postgres inside the including test's transaction, which rolls
-- back at the end. Not a test itself: pg_prove only runs *.sql / *.pg files.
--
-- Usage (first lines of a test file):
--   begin;
--   \ir helpers/fixtures.psql
--   select plan(n);
--   :as_dev_aal2            -- act as the developer in an aal2 session
--   …
--   :as_postgres            -- back to the owner, no JWT
--
-- Identity macros (each expands to SET LOCAL role + request.jwt.claims):
--   :as_<who>_aal1 / :as_<who>_aal2   who = dev | adm | tre | lea | med | non | pen
--   :as_anon   :as_service   :as_postgres
-- pg_temp.gotrue_delete_user(uuid) deletes an account the way GoTrue does;
-- :gotrue_role says whether it runs as supabase_auth_admin.
-- Accounts:
--   dev  Desarrollador  admin + {ministries,users,activity,settings}
--   adm  Administrador  admin + {}
--   tre  Tesorería      treasurer
--   lea  leader with every operational tab, leads ministry M1
--   med  Medios         ministry_leader + {upcoming,calendario,special-events,galeria}
--   non  leader with no tabs
--   pen  a pending invitation (unconfirmed) carrying the developer grant
-- ============================================================================

\set dev_id 'a0000000-0000-4000-8000-000000000001'
\set adm_id 'a0000000-0000-4000-8000-000000000002'
\set tre_id 'a0000000-0000-4000-8000-000000000003'
\set lea_id 'a0000000-0000-4000-8000-000000000004'
\set med_id 'a0000000-0000-4000-8000-000000000005'
\set non_id 'a0000000-0000-4000-8000-000000000006'
\set pen_id 'a0000000-0000-4000-8000-000000000007'
\set m1_id  'b0000000-0000-4000-8000-000000000001'
\set m2_id  'b0000000-0000-4000-8000-000000000002'

\set as_postgres 'reset role; set local request.jwt.claims = '''';'
\set as_anon     'set local role anon; set local request.jwt.claims = ''{"role":"anon"}'';'
\set as_service  'set local role service_role; set local request.jwt.claims = ''{"role":"service_role"}'';'

\set as_dev_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000001","role":"authenticated","aal":"aal1"}'';'
\set as_dev_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000001","role":"authenticated","aal":"aal2"}'';'
\set as_adm_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000002","role":"authenticated","aal":"aal1"}'';'
\set as_adm_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000002","role":"authenticated","aal":"aal2"}'';'
\set as_tre_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000003","role":"authenticated","aal":"aal1"}'';'
\set as_tre_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000003","role":"authenticated","aal":"aal2"}'';'
\set as_lea_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000004","role":"authenticated","aal":"aal1"}'';'
\set as_lea_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000004","role":"authenticated","aal":"aal2"}'';'
\set as_med_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000005","role":"authenticated","aal":"aal1"}'';'
\set as_med_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000005","role":"authenticated","aal":"aal2"}'';'
\set as_non_aal1 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000006","role":"authenticated","aal":"aal1"}'';'
\set as_non_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000006","role":"authenticated","aal":"aal2"}'';'
\set as_pen_aal2 'set local role authenticated; set local request.jwt.claims = ''{"sub":"a0000000-0000-4000-8000-000000000007","role":"authenticated","aal":"aal2"}'';'

-- GoTrue's admin delete as GoTrue runs it: unqualified `users`, under its role
-- and that role's search_path (auth). The profile goes with it through
-- profiles_id_fkey ON DELETE CASCADE, inside the same transaction. Taking the
-- role needs `grant supabase_auth_admin to postgres with set true` (db.yml does
-- it on the CI stack); without it the delete runs as postgres, same search_path.
select pg_has_role('supabase_auth_admin', 'SET') as gotrue_role \gset
\if :gotrue_role
create function pg_temp.gotrue_delete_user(p_id uuid) returns void
language plpgsql set role = supabase_auth_admin set search_path = auth as $$
begin
  delete from users where id = p_id;
end $$;
\else
create function pg_temp.gotrue_delete_user(p_id uuid) returns void
language plpgsql set search_path = auth as $$
begin
  delete from users where id = p_id;
end $$;
\endif

