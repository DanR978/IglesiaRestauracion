# ═══════════════════════════════════════════════════════════════════════════
#  supabase/.env.auth.local.example
#  The OAuth provider values apply-auth-email.mjs reads with --secret-file.
#  Copy it to supabase/.env.auth.local (git ignores .env.*.local; the script
#  refuses a file git would commit), fill it in, and delete the copy once the
#  secrets are in Supabase. This repo is public: real values never go here.
#
#  Rules: KEY=VALUE, one per line, comments on their own line. A value still in
#  <angle brackets> is a placeholder and is refused. Leave a provider's values
#  empty and the script leaves that provider exactly as it is. A variable set
#  both here and in the environment must hold the same value.
#
#  Usage:
#    node supabase/apply-auth-email.mjs --token-file <path> --secret-file supabase/.env.auth.local
#    … --secret-file supabase/.env.auth.local --rotate-secrets --apply
#
#  The Management API token is not read from this file: it reaches every
#  project the account can, so pass it as SUPABASE_ACCESS_TOKEN or with
#  --token-file pointing outside the repo, and revoke it when done.
# ═══════════════════════════════════════════════════════════════════════════

# ── Google ─────────────────────────────────────────────────────────────────
# Google Auth Platform → Clients → the "Web application" client.
# Format: <digits>-<letters and digits>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=<123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com>
# The client's secret (GOCSPX-…). Sent only with --rotate-secrets.
GOOGLE_OAUTH_CLIENT_SECRET=<google-client-secret>

# ── Microsoft Entra ID (single tenant) ─────────────────────────────────────
# App registrations → the app → Overview → "Application (client) ID".
AZURE_OAUTH_CLIENT_ID=<00000000-0000-0000-0000-000000000000>
# Same page → "Directory (tenant) ID": a GUID, never "common" or "organizations".
# The script sets the provider URL to https://login.microsoftonline.com/<this GUID>.
AZURE_TENANT_ID=<00000000-0000-0000-0000-000000000000>
# Certificates & secrets → Client secrets → the "Value" column (not "Secret ID").
# Expires in at most 12 months: keep a calendar reminder to rotate it.
# Sent only with --rotate-secrets.
AZURE_OAUTH_CLIENT_SECRET=<entra-client-secret-value>
