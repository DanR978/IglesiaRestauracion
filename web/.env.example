# Copy to web/.env for local dev/builds (web/.env is gitignored).
# PUBLIC values only — the anon key is public by design (RLS is the boundary,
# MIGRATION.md D-002/D-007). Never put a service-role key here or anywhere in web/.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<supabase anon key>
