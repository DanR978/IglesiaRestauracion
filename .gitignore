.env
.env.local
.env.*.local

# Ignore OS-specific clutter
.DS_Store
Thumbs.db

# VS Code settings (optional)
.vscode/

# Python cache (if you're using any scripts)
__pycache__/
*.pyc

# Logs (if any are generated)
*.log

# GitHub Pages doesn’t need build or dist folders (if not used)
dist/
build/

# Ignore local configuration files
js/lib/config.js
node_modules/

migrations/
# …but Supabase migrations ARE version-controlled (see supabase/README.md).
!supabase/migrations/
!supabase/migrations/**

# Claude scratch notes
.claude/scratch/
.claude/temp/
.claude/brainstorm.md